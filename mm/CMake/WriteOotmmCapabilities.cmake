if(NOT DEFINED OOTMM_EXECUTABLE OR NOT EXISTS "${OOTMM_EXECUTABLE}")
    message(FATAL_ERROR "OoTMM capability manifest requires a built executable")
endif()
if(NOT OOTMM_GAME STREQUAL "oot" AND NOT OOTMM_GAME STREQUAL "mm")
    message(FATAL_ERROR "Unknown OoTMM game")
endif()
file(SHA256 "${OOTMM_EXECUTABLE}" OOTMM_SHA256)
set(OOTMM_CAPABILITIES "\"bound-save-v1\",\"paired-copy-v1\",\"shared-resources-v1\"")
if(OOTMM_GAME STREQUAL "mm")
    string(APPEND OOTMM_CAPABILITIES ",\"mm-recovery-v1\",\"native-save-validation-v1\",\"mm-validation-command-v1\"")
endif()
file(WRITE "${OOTMM_EXECUTABLE}.ootmm.json.tmp" "{\"schema\":1,\"game\":\"${OOTMM_GAME}\",\"bootProtocol\":1,\"sha256\":\"${OOTMM_SHA256}\",\"capabilities\":[${OOTMM_CAPABILITIES}]}\n")
file(RENAME "${OOTMM_EXECUTABLE}.ootmm.json.tmp" "${OOTMM_EXECUTABLE}.ootmm.json")
